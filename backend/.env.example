# Supabase PostgreSQL connection string (use Transaction or Session pooler URI)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth configuration (never expose service role key in frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated

# CORS origins allowed to call FastAPI (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Expiry background watcher interval in seconds
EXPIRY_WATCHER_INTERVAL_SECONDS=5
